{
  "name": "yt-dlp",
  "buildsystem": "simple",
  "build-commands": [
    "install -d /app/lib/python3.13/site-packages",
    "python3 -m zipfile -e yt_dlp.whl /app/lib/python3.13/site-packages",
    "python3 -c \"import yt_dlp; print('yt-dlp', yt_dlp.version.__version__)\"",
    "install -d /app/bin",
    "printf '#!/bin/sh\\nexec python3 -m yt_dlp \\\"$@\\\"\\n' > /app/bin/yt-dlp",
    "chmod 755 /app/bin/yt-dlp"
  ],
